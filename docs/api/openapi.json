{
  "openapi": "3.1.0",
  "info": {
    "title": "TabHop API",
    "description": "Payment orchestration and settlement platform for hospitality venues",
    "version": "0.0.1",
    "contact": {
      "name": "TabHop Support"
    }
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development"
    },
    {
      "url": "https://api.sandbox.tabhop.com",
      "description": "Sandbox environment"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check endpoint",
        "description": "Returns the health status of the API",
        "operationId": "getHealth",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "healthy"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "summary": "Create a new order",
        "description": "Create an order with line items, calculate pricing including tax and platform fees",
        "operationId": "createOrder",
        "tags": ["Orders"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["venueId", "lines"],
                "properties": {
                  "venueId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Venue/primary merchant ID"
                  },
                  "tableNumber": {
                    "type": "string",
                    "description": "Table number (optional)"
                  },
                  "serverStaffId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Server staff ID (optional)"
                  },
                  "lines": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["itemId", "quantity"],
                      "properties": {
                        "itemId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "quantity": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  },
                  "tipAmount": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Tip amount in dollars (optional, default 0)"
                  },
                  "idempotencyKey": {
                    "type": "string",
                    "description": "Idempotency key for deduplication (optional)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "order": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "venueId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "status": {
                          "type": "string",
                          "enum": ["PENDING", "CAPTURED", "SETTLED", "FAILED"]
                        },
                        "subtotalCents": {
                          "type": "integer"
                        },
                        "taxCents": {
                          "type": "integer"
                        },
                        "tipCents": {
                          "type": "integer"
                        },
                        "platformFeeCents": {
                          "type": "integer"
                        },
                        "totalCents": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "code": {
                      "type": "string",
                      "enum": ["VALIDATION_ERROR", "ITEM_INACTIVE"]
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "code": {
                      "type": "string",
                      "example": "NOT_FOUND"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "summary": "Get order details",
        "description": "Retrieve an order with all items and current status",
        "operationId": "getOrder",
        "tags": ["Orders"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "order": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "venueId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "serverStaffId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "tableNumber": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": ["PENDING", "CAPTURED", "SETTLED", "FAILED"]
                        },
                        "paypalOrderId": {
                          "type": "string"
                        },
                        "paypalCaptureId": {
                          "type": "string"
                        },
                        "subtotalCents": {
                          "type": "integer"
                        },
                        "taxCents": {
                          "type": "integer"
                        },
                        "tipCents": {
                          "type": "integer"
                        },
                        "platformFeeCents": {
                          "type": "integer"
                        },
                        "totalCents": {
                          "type": "integer"
                        },
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "itemId": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "itemName": {
                                "type": "string"
                              },
                              "quantity": {
                                "type": "integer"
                              },
                              "unitPriceCents": {
                                "type": "integer"
                              }
                            }
                          }
                        },
                        "payoutBatch": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "paypalBatchId": {
                              "type": "string"
                            },
                            "status": {
                              "type": "string"
                            }
                          }
                        },
                        "capturedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid order ID format"
          },
          "404": {
            "description": "Order not found"
          }
        }
      }
    },
    "/orders/{id}/paypal": {
      "post": {
        "summary": "Create PayPal order",
        "description": "Create a PayPal order for payment processing",
        "operationId": "createPayPalOrder",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PayPal order created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "paypalOrderId": {
                      "type": "string"
                    },
                    "approvalUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Order not found"
          }
        }
      }
    },
    "/orders/{id}/capture": {
      "post": {
        "summary": "Capture PayPal order and settle",
        "description": "Capture a PayPal order and dispatch settlement to merchants",
        "operationId": "capturePayPalOrder",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order captured and settlement initiated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "paypalCaptureId": {
                      "type": "string"
                    },
                    "payoutBatchId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Order not found"
          }
        }
      }
    },
    "/settlements": {
      "get": {
        "summary": "List settlements",
        "description": "Retrieve paginated settlement ledger",
        "operationId": "getSettlements",
        "tags": ["Settlements"],
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "take",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Settlement ledger",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "settlements": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "orderId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "merchantId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "amountCents": {
                            "type": "integer"
                          },
                          "status": {
                            "type": "string",
                            "enum": ["PENDING", "PROCESSING", "SUCCESS", "FAILED"]
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/settlements/{orderId}/retry": {
      "post": {
        "summary": "Retry failed settlement",
        "description": "Retry a failed settlement batch",
        "operationId": "retrySettlement",
        "tags": ["Settlements"],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Settlement retry initiated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Settlement not found"
          }
        }
      }
    },
    "/webhooks/paypal": {
      "post": {
        "summary": "PayPal webhook",
        "description": "Receive and process PayPal webhook events (e.g., payment captured)",
        "operationId": "handlePayPalWebhook",
        "tags": ["Webhooks"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook processed"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "venueId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "CAPTURED", "SETTLED", "FAILED"]
          },
          "totalCents": {
            "type": "integer"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Health",
      "description": "Health check endpoints"
    },
    {
      "name": "Orders",
      "description": "Order management"
    },
    {
      "name": "Payments",
      "description": "Payment processing"
    },
    {
      "name": "Settlements",
      "description": "Settlement and payout management"
    },
    {
      "name": "Webhooks",
      "description": "Webhook handlers"
    }
  ]
}
